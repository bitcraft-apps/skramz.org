# Shared config (root). Secrets go in wrangler secret store / GitHub secrets — never here.
CLOUDFLARE_ACCOUNT_ID=
# D1 (SQLite, bound to the Worker as `DB`)
D1_DATABASE_ID=
# R2 (cover art / band photos)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=skramz-media
# Write auth for ingestion endpoints (dev only; prod via `wrangler secret put INGESTION_TOKEN`)
INGESTION_TOKEN=
# Public API base URL for the Vite SPA, baked at build time (ADR-0004).
VITE_API_URL=https://api.skramz.org
# Public R2 media host for art URLs, baked at build time (infra/r2.md).
VITE_MEDIA_URL=https://media.skramz.org
# Public Cloudflare Web Analytics site token, baked at build time
# (infra/web-hosting.md). Empty stays silent: no beacon in dev or previews.
VITE_CF_BEACON_TOKEN=
